{
  "name": "@vernaculo/compiler",
  "version": "0.0.0",
  "description": "Compilador do Vernáculo: transforma a representação intermediária de uma persona em instruções neutras de provedor. Determinístico; nunca chama um modelo.",
  "license": "Apache-2.0",
  "keywords": [
    "vernaculo",
    "ia",
    "agentes-de-ia",
    "llm",
    "portugues-brasileiro",
    "pt-br",
    "sociolinguistica",
    "regionalismos",
    "localizacao",
    "persona"
  ],
  "homepage": "https://github.com/Jovinull/vernaculo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jovinull/vernaculo.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/Jovinull/vernaculo/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@vernaculo/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@vernaculo/core": "workspace:^",
    "@vernaculo/schema": "workspace:^"
  }
}
