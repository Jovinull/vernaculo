{
  "name": "@vernaculo/core",
  "version": "0.0.0",
  "description": "Vernáculo core: parse, validate and resolve persona documents and apply regional intensity. No provider, no network.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@vernaculo/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@vernaculo/source": "./src/node.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@vernaculo/schema": "workspace:^",
    "yaml": "^2.9.1"
  }
}
