{
  "name": "@vernaculo/core",
  "version": "0.0.0",
  "description": "Núcleo do Vernáculo: parse, validação e resolução de personas e aplicação da intensidade regional. Sem provedor, sem rede.",
  "license": "Apache-2.0",
  "keywords": [
    "vernaculo",
    "ia",
    "agentes-de-ia",
    "llm",
    "portugues-brasileiro",
    "pt-br",
    "sociolinguistica",
    "regionalismos",
    "localizacao",
    "persona"
  ],
  "homepage": "https://github.com/Jovinull/vernaculo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jovinull/vernaculo.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Jovinull/vernaculo/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@vernaculo/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@vernaculo/source": "./src/node.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@vernaculo/schema": "workspace:^",
    "yaml": "^2.9.1"
  }
}
