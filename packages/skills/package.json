{
  "name": "@vernaculo/skills",
  "version": "0.0.0",
  "description": "Vernáculo exporter for Agent Skills: turns a persona into a self-contained SKILL.md directory.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@vernaculo/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@vernaculo/compiler": "workspace:^",
    "@vernaculo/core": "workspace:^",
    "yaml": "^2.9.1"
  }
}
