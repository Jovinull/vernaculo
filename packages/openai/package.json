{
  "name": "@vernaculo/openai",
  "version": "0.0.0",
  "description": "Vernáculo adapter for the OpenAI Responses API. Shapes compiled persona instructions for your own OpenAI client; no SDK dependency, no requests.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@vernaculo/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@vernaculo/compiler": "workspace:^"
  }
}
