{
  "name": "vernaculo",
  "version": "0.0.0",
  "description": "CLI do Vernáculo: inspeciona, valida, compila, exporta e ejeta personas regionais para agentes de IA. Roda localmente; nenhum serviço do Vernáculo envolvido.",
  "license": "Apache-2.0",
  "keywords": [
    "vernaculo",
    "ia",
    "agentes-de-ia",
    "llm",
    "portugues-brasileiro",
    "pt-br",
    "sociolinguistica",
    "regionalismos",
    "localizacao",
    "persona"
  ],
  "homepage": "https://github.com/Jovinull/vernaculo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jovinull/vernaculo.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Jovinull/vernaculo/issues"
  },
  "type": "module",
  "bin": {
    "vernaculo": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "@vernaculo/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@vernaculo/compiler": "workspace:^",
    "@vernaculo/core": "workspace:^",
    "@vernaculo/openai": "workspace:^",
    "@vernaculo/skills": "workspace:^",
    "commander": "^15.0.0"
  }
}
