{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vernaculo:schema:v1alpha1:persona",
  "title": "Persona do Vernáculo (v1alpha1)",
  "description": "Contrato estrutural normativo de um documento de persona do Vernáculo (apiVersion vernaculo.dev/v1alpha1). Uma persona descreve traços sociolinguísticos observáveis de uma variedade linguística. É dado, não prompt: compiladores a transformam em instruções. A validade estrutural é necessária, mas não suficiente; as regras semânticas de docs/specification/persona-format.md também se aplicam. Esta versão é ALFA e pode mudar de forma incompatível.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata"],
  "properties": {
    "apiVersion": {
      "description": "Versão da especificação. 'vernaculo.dev' é um identificador de namespace e nunca é buscado na rede.",
      "const": "vernaculo.dev/v1alpha1"
    },
    "kind": {
      "const": "Persona"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "extends": {
      "description": "Id explícito da persona pai. A herança nunca é implícita na hierarquia do id.",
      "$ref": "#/$defs/personaId"
    },
    "regionality": {
      "$ref": "#/$defs/regionality"
    },
    "linguistics": {
      "$ref": "#/$defs/linguistics"
    },
    "examples": {
      "description": "Exemplos positivos: como uma frase neutra pode ficar com os traços desta variedade aplicados.",
      "type": "array",
      "items": { "$ref": "#/$defs/example" }
    },
    "antiPatterns": {
      "description": "Exemplos negativos: saídas que devem ser evitadas, com o motivo.",
      "type": "array",
      "items": { "$ref": "#/$defs/antiPattern" }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "personaId": {
      "description": "Id separado por barras. Primeiro segmento: uma tag de idioma BCP 47 (por exemplo, pt-BR). Segmentos seguintes: slugs ASCII minúsculos que nomeiam variedades progressivamente mais estreitas (por exemplo, pt-BR/ba/salvador). Os segmentos são nomes, não uma cadeia de herança.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*(/[a-z0-9]+(-[a-z0-9]+)*)*$"
    },
    "languageTag": {
      "description": "Tag de idioma BCP 47 (verificação de sintaxe simplificada).",
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "intensity": {
      "description": "Intensidade regional: 0 = neutra (sem marcação regional), 1 = a renderização mais marcada que a persona suporta. Intensidade alta nunca afrouxa as regras de naturalidade ou anti-caricatura.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maturity": {
      "description": "fixture: dado sintético para testes, nunca conteúdo linguístico. draft: em pesquisa, não revisado. reviewed: uma revisão humana por falantes realmente aconteceu (docs/linguistic/human-review.md); a revisão é recomendada, nunca obrigatória.",
      "enum": ["fixture", "draft", "reviewed"]
    },
    "evidence": {
      "description": "attested: documentado em fonte de pesquisa ou referência. reported: confirmado em revisão por falantes (cite a revisão). corroborated: quando não houver fonte para attested, duas fontes públicas independentes, ao menos uma local e com base de evidência independente, descrevem a forma no mesmo sentido; exige minIntensity >= 0.5 e é renderizado à parte, sem revisão estruturada por falantes. Indica convergência documental, não frequência, exclusividade regional ou naturalidade geral. hypothesis: não confirmado; compiladores NÃO DEVEM renderizá-lo. synthetic: dado de teste inventado; permitido apenas em personas fixture.",
      "enum": ["attested", "reported", "corroborated", "hypothesis", "synthetic"]
    },
    "sourceRefs": {
      "description": "Ids de entradas de provenance.sources (desta persona ou de um ancestral).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slug" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "language", "version", "maturity"],
      "properties": {
        "id": { "$ref": "#/$defs/personaId" },
        "name": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/longText" },
        "language": {
          "description": "Deve ser igual ao primeiro segmento de metadata.id.",
          "$ref": "#/$defs/languageTag"
        },
        "version": { "$ref": "#/$defs/semver" },
        "maturity": { "$ref": "#/$defs/maturity" },
        "license": {
          "description": "Licença do conteúdo desta persona (expressão SPDX recomendada). Não é herdada.",
          "$ref": "#/$defs/shortText"
        },
        "region": { "$ref": "#/$defs/region" }
      }
    },
    "region": {
      "description": "Informação geográfica descritiva. Apenas informativa: nunca guia a herança, e uma variedade não precisa coincidir com uma fronteira administrativa.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "description": "Código ISO 3166-1 alfa-2.",
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "subdivision": {
          "description": "Código de subdivisão ISO 3166-2 sem o prefixo do país (por exemplo, BA para BR-BA).",
          "type": "string",
          "pattern": "^[A-Z0-9]{1,3}$"
        },
        "locality": { "$ref": "#/$defs/shortText" },
        "note": { "$ref": "#/$defs/longText" }
      }
    },
    "regionality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "lexicalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "evidence"],
      "properties": {
        "term": { "$ref": "#/$defs/shortText" },
        "meaning": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "contextualItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "context", "evidence"],
      "properties": {
        "term": { "$ref": "#/$defs/shortText" },
        "context": { "$ref": "#/$defs/longText" },
        "meaning": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "discouragedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term"],
      "properties": {
        "term": { "$ref": "#/$defs/shortText" },
        "reason": { "$ref": "#/$defs/longText" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" }
      }
    },
    "discourseMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "function", "evidence"],
      "properties": {
        "form": { "$ref": "#/$defs/shortText" },
        "function": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "morphosyntaxPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "description": { "$ref": "#/$defs/longText" },
        "example": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "pragmaticForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "evidence"],
      "properties": {
        "form": { "$ref": "#/$defs/shortText" },
        "usage": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "linguistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vocabulary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferred": {
              "type": "array",
              "items": { "$ref": "#/$defs/lexicalItem" }
            },
            "contextual": {
              "type": "array",
              "items": { "$ref": "#/$defs/contextualItem" }
            },
            "discouraged": {
              "type": "array",
              "items": { "$ref": "#/$defs/discouragedItem" }
            }
          }
        },
        "discourse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "markers": {
              "type": "array",
              "items": { "$ref": "#/$defs/discourseMarker" }
            }
          }
        },
        "morphosyntax": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "patterns": {
              "type": "array",
              "items": { "$ref": "#/$defs/morphosyntaxPattern" }
            }
          }
        },
        "pragmatics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "addressForms": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            },
            "greetings": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            },
            "acknowledgements": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            },
            "disagreements": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            },
            "closings": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            }
          }
        },
        "orthography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phoneticSpelling": {
              "description": "Se grafias fonéticas (eye dialect) podem ser usadas. O padrão é 'avoid' quando ausente em toda a linhagem.",
              "enum": ["avoid", "allow"]
            }
          }
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "situation", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "situation": { "$ref": "#/$defs/shortText" },
        "neutral": { "$ref": "#/$defs/longText" },
        "text": { "$ref": "#/$defs/longText" },
        "intensity": { "$ref": "#/$defs/intensity" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" }
      }
    },
    "antiPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "category", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "text": { "$ref": "#/$defs/longText" },
        "category": {
          "enum": [
            "caricature",
            "stereotype",
            "overuse",
            "phonetic-spelling",
            "invented-regionalism",
            "wrong-region",
            "register-mismatch",
            "other"
          ]
        },
        "explanation": { "$ref": "#/$defs/longText" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "usage"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "type": {
          "enum": ["atlas", "corpus", "study", "reference-work", "speaker-review", "other"]
        },
        "title": { "$ref": "#/$defs/shortText" },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^https?://[^\\s]+$"
        },
        "citation": { "$ref": "#/$defs/longText" },
        "license": { "$ref": "#/$defs/shortText" },
        "usage": {
          "description": "O que esta persona faz com a fonte: consulted (apenas lida), cited (referenciada/citada brevemente), redistributed (material copiado para o pack; exige licença compatível).",
          "enum": ["consulted", "cited", "redistributed"]
        },
        "accessed": {
          "description": "Data em que a fonte foi consultada (AAAA-MM-DD).",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notes": { "$ref": "#/$defs/longText" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "notes": { "$ref": "#/$defs/longText" }
      }
    }
  }
}
