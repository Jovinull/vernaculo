{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vernaculo:schema:v1alpha1:persona",
  "title": "Vernáculo Persona (v1alpha1)",
  "description": "Normative structural contract for a Vernáculo persona document (apiVersion vernaculo.dev/v1alpha1). A persona describes observable, sociolinguistic features of a language variety. It is data, not a prompt: compilers turn it into instructions. Structural validity is necessary but not sufficient; the semantic rules in docs/specification/persona-format.md also apply. This version is ALPHA and may change incompatibly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata"],
  "properties": {
    "apiVersion": {
      "description": "Specification version. 'vernaculo.dev' is a namespace identifier, never fetched over the network.",
      "const": "vernaculo.dev/v1alpha1"
    },
    "kind": {
      "const": "Persona"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "extends": {
      "description": "Explicit parent persona id. Inheritance is never implied by the id hierarchy.",
      "$ref": "#/$defs/personaId"
    },
    "regionality": {
      "$ref": "#/$defs/regionality"
    },
    "linguistics": {
      "$ref": "#/$defs/linguistics"
    },
    "examples": {
      "description": "Positive examples: how a neutral utterance may look with this variety's features applied.",
      "type": "array",
      "items": { "$ref": "#/$defs/example" }
    },
    "antiPatterns": {
      "description": "Negative examples: outputs that must be avoided, with the reason.",
      "type": "array",
      "items": { "$ref": "#/$defs/antiPattern" }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "personaId": {
      "description": "Slash-separated id. First segment: a BCP 47 language tag (e.g. pt-BR). Following segments: lowercase ASCII slugs naming progressively narrower varieties (e.g. pt-BR/ba/salvador). Segments are names, not an inheritance chain.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*(/[a-z0-9]+(-[a-z0-9]+)*)*$"
    },
    "languageTag": {
      "description": "BCP 47 language tag (simplified syntax check).",
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "intensity": {
      "description": "Regional intensity: 0 = neutral (no regional marking), 1 = the most marked rendering the persona supports. High intensity never relaxes naturalness or anti-caricature rules.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maturity": {
      "description": "fixture: synthetic data for tests, never linguistic content. draft: under research, not reviewed. reviewed: human review completed per docs/linguistic/human-review.md.",
      "enum": ["fixture", "draft", "reviewed"]
    },
    "evidence": {
      "description": "attested: documented in cited sources. reported: reported by speakers/reviewers (cite the review as a source). hypothesis: unconfirmed; compilers MUST NOT render it. synthetic: invented test data; only allowed in fixture personas.",
      "enum": ["attested", "reported", "hypothesis", "synthetic"]
    },
    "sourceRefs": {
      "description": "Ids of entries in provenance.sources (of this persona or an ancestor).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slug" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "language", "version", "maturity"],
      "properties": {
        "id": { "$ref": "#/$defs/personaId" },
        "name": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/longText" },
        "language": {
          "description": "Must equal the first segment of metadata.id.",
          "$ref": "#/$defs/languageTag"
        },
        "version": { "$ref": "#/$defs/semver" },
        "maturity": { "$ref": "#/$defs/maturity" },
        "license": {
          "description": "License of this persona's content (SPDX expression recommended). Not inherited.",
          "$ref": "#/$defs/shortText"
        },
        "region": { "$ref": "#/$defs/region" }
      }
    },
    "region": {
      "description": "Descriptive geographic information. Informational only: it never drives inheritance, and a variety need not coincide with an administrative boundary.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "description": "ISO 3166-1 alpha-2 code.",
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "subdivision": {
          "description": "ISO 3166-2 subdivision code without the country prefix (e.g. BA for BR-BA).",
          "type": "string",
          "pattern": "^[A-Z0-9]{1,3}$"
        },
        "locality": { "$ref": "#/$defs/shortText" },
        "note": { "$ref": "#/$defs/longText" }
      }
    },
    "regionality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "lexicalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "evidence"],
      "properties": {
        "term": { "$ref": "#/$defs/shortText" },
        "meaning": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "contextualItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "context", "evidence"],
      "properties": {
        "term": { "$ref": "#/$defs/shortText" },
        "context": { "$ref": "#/$defs/longText" },
        "meaning": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "discouragedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term"],
      "properties": {
        "term": { "$ref": "#/$defs/shortText" },
        "reason": { "$ref": "#/$defs/longText" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" }
      }
    },
    "discourseMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "function", "evidence"],
      "properties": {
        "form": { "$ref": "#/$defs/shortText" },
        "function": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "morphosyntaxPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "description": { "$ref": "#/$defs/longText" },
        "example": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "pragmaticForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "evidence"],
      "properties": {
        "form": { "$ref": "#/$defs/shortText" },
        "usage": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" },
        "minIntensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "linguistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vocabulary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferred": {
              "type": "array",
              "items": { "$ref": "#/$defs/lexicalItem" }
            },
            "contextual": {
              "type": "array",
              "items": { "$ref": "#/$defs/contextualItem" }
            },
            "discouraged": {
              "type": "array",
              "items": { "$ref": "#/$defs/discouragedItem" }
            }
          }
        },
        "discourse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "markers": {
              "type": "array",
              "items": { "$ref": "#/$defs/discourseMarker" }
            }
          }
        },
        "morphosyntax": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "patterns": {
              "type": "array",
              "items": { "$ref": "#/$defs/morphosyntaxPattern" }
            }
          }
        },
        "pragmatics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "addressForms": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            },
            "greetings": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            },
            "acknowledgements": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            },
            "disagreements": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            },
            "closings": {
              "type": "array",
              "items": { "$ref": "#/$defs/pragmaticForm" }
            }
          }
        },
        "orthography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phoneticSpelling": {
              "description": "Whether eye-dialect/phonetic spellings may be used. Defaults to 'avoid' when absent in the whole lineage.",
              "enum": ["avoid", "allow"]
            }
          }
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "situation", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "situation": { "$ref": "#/$defs/shortText" },
        "neutral": { "$ref": "#/$defs/longText" },
        "text": { "$ref": "#/$defs/longText" },
        "intensity": { "$ref": "#/$defs/intensity" },
        "sources": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "$ref": "#/$defs/longText" }
      }
    },
    "antiPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "category", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "text": { "$ref": "#/$defs/longText" },
        "category": {
          "enum": [
            "caricature",
            "stereotype",
            "overuse",
            "phonetic-spelling",
            "invented-regionalism",
            "wrong-region",
            "register-mismatch",
            "other"
          ]
        },
        "explanation": { "$ref": "#/$defs/longText" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "usage"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "type": {
          "enum": ["atlas", "corpus", "study", "reference-work", "speaker-review", "other"]
        },
        "title": { "$ref": "#/$defs/shortText" },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^https?://[^\\s]+$"
        },
        "citation": { "$ref": "#/$defs/longText" },
        "license": { "$ref": "#/$defs/shortText" },
        "usage": {
          "description": "What this persona does with the source: consulted (read only), cited (referenced/quoted briefly), redistributed (material copied into the pack; requires a compatible license).",
          "enum": ["consulted", "cited", "redistributed"]
        },
        "accessed": {
          "description": "Date the source was consulted (YYYY-MM-DD).",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notes": { "$ref": "#/$defs/longText" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "notes": { "$ref": "#/$defs/longText" }
      }
    }
  }
}
